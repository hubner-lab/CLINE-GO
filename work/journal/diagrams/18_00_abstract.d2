direction: right

run: "Полный прогон one-fit (Фаза 2b)" {
  rerun: "600 реплик заново\n~15 ч, гейт gea"
  gate: "LFMM/EMMAX 1200/1200 байт-в-байт\ntruth 600/600 без изменений"
  rerun -> gate
}

measure: "Повторное измерение (Фаза 3)" {
  grid: "та же сетка: 20 правил × 3 метода × 5 окон\n600 реплик, все проверки пройдены"
  bind: "p RDA только снизились\nбарьер связывал на 51 % SNP"
  fixed: "bonf 0.05: 1 → 450 вызовов RDA\n131 каузальных, 18 фоновых"
  rank: "ранжирование RDA хуже\nAUC-PR 0.072 → 0.040 (517 из 600)"
  panel: "≥2 из 3 при bonf/qval\nнепусто 23–37 % (окно 0)"
  grid -> bind
  grid -> fixed
  grid -> rank
  grid -> panel
}

side: "Побочные таблицы сбора" {
  ld: "LD decay: половина 1.6 kb\n1.35–1.71 kb во всех 600"
  k: "λ EMMAX прежняя\nлоктевая ГК = K в 58 %"
}

gate: "Гейт Фазы 3\nопределение RDA · правило · окно · K"

run.gate -> measure.grid
measure.rank -> gate
measure.panel -> gate
side.ld -> gate
side.k -> gate

p3b: "Фаза 3b" {
  unc: "RDA без коррекции, 600 реплик\npmax = max(двух fit) точно, U2 0 расхождений"
  three: "AUC-PR RDA, медиана\none-fit 0.040 · pmax 0.072 · без коррекции 0.217"
  why: "ГК условия коллинеарны климату\nостаётся 8 % скорр. R²"
  ledger: "реестр: 35 ячеек, one-fit RDA\n≥2 из 3: F1 0.09–0.13, непусто 100 %"
  unc -> three
  three -> why
}

gate3b: "Решение Фазы 3b\nRDA без коррекции — третий метод\ntop 0.25 % · окно 5 kb · 1/3, 2/3, 3/3"

gate -> p3b.unc
gate -> p3b.ledger
p3b.why -> gate3b
p3b.ledger -> gate3b

p4a: "Панели Фазы 4a" {
  build: "6 панелей × 600 реплик\nRDA × 2: привязка 4080 / 4080\n1/3 310 · 2/3 217 · 3/3 131 SNP"
  cost: "цена свипа offset12\ngeometric_offset = 92 % часов заданий\n896 одинаковых подгонок lfmm2 на реплику"
}

gate4a: "Гейт 4a\nRDA × 2 (0.5 %) · truth пересчитать\nускорение A · кривая размера b1"

gate3b -> p4a.build
p4a.build -> gate4a
p4a.cost -> gate4a

p4b: "Фаза 4b" {
  fix: "geometric_offset: одна подгонка lfmm2\nстарый = новый побайтно, 338 / 338\n25 с вместо 675 с"
  pilot: "пилот: 11 панелей за 700 с\nсухой прогон 600 / 600 чист"
  sweep: "свип 600 реплик за 7.3 ч\n2 095 744 таблицы офсета · 0 сбоев\nоценка 12 мин (параллельно)"
  fix -> pilot -> sweep
}
gate4a -> p4b.fix

det2x: "Детекция с честным RDA (0.5 %)\n2/3: P 0.27 → 0.22, F1 0.211 → 0.178\nсводка и таблицы пересобраны"
gate4a -> det2x

acc4b: "Точность офсета (Шаг 17)" {
  oracle: "все 6 панелей ниже каузальных\ndelta −0.026 … −0.040 · ≥2 из 3 −0.032\n≥2 из 3 − 1 из 3 = +0.0006"
  rda: "RDA с коррекцией хуже без коррекции\nна каузальных 0.640 vs 0.783\n«наоборот» 0.024 %, не 2.65 %"
  size: "кривая размера b1: 49 → 918 SNP\nэффект размера не обнаружен, Фридман p = 0.18"
}
gate4b: "Гейт завершения 4b\nпринять · RDA с коррекцией · случайная опора? · рекомендуемая панель"
p4b.sweep -> acc4b.oracle
p4b.sweep -> acc4b.rda
p4b.sweep -> acc4b.size
acc4b.oracle -> gate4b
acc4b.rda -> gate4b
acc4b.size -> gate4b

rank18: "Ранг панели внутри реплики (Шаг 18)\n≥2 из 3 худшая в 1.8 % реплик\nлучшая в 4.3 %: страховка, не победитель"
gate4b -> rank18
p5: "Рисунки рукописи (Фаза 5)\nРисунок 2: детекция + ранг · S1–S8\nмешки вместо контуров, порядок по данным"
rank18 -> p5
ms: "Набор рукописи (Шаги 22–24)\nодно правило ничьих: 25 из 2 400, все парные\n≥2 из 3 худшая 1.83 %, в двух худших 11.08 %\nсловарь рукописи · S2, S3, S8 · Таблица S1 · Data S2"
p5 -> ms
